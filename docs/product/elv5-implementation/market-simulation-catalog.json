    {"code":"PORT_OR_ADDRESS_ALIAS","preventedBy":["P4","P5","P6"],"engineerImpact":"Prevents false spare capacity caused by treating aliases as separate hardware resources."},
    {"code":"OPTICAL_OVERLOAD_IGNORED","preventedBy":["P4"],"engineerImpact":"Prevents false fiber PASS where receiver sensitivity passes but overload fails."},
    {"code":"OPTICAL_BUDGET_EQUALS_REACH","preventedBy":["P4","P9"],"engineerImpact":"Prevents claiming reach/dispersion compatibility from power budget alone."},
    {"code":"RACK_CAPACITY_EQUALS_LAYOUT","preventedBy":["P4","P9"],"engineerImpact":"Keeps RU/weight/depth demand separate from ELV6 physical cabinet fit."},
    {"code":"CONTROL_PATH_EQUALS_POWER_FEED","preventedBy":["P5"],"engineerImpact":"Prevents a relay/control adjacency from being mistaken for a conductive lock supply path."},
